# ai-jail sandbox configuration
# https://github.com/akitaonrails/ai-jail
# Edit freely. Regenerate with: ai-jail --clean --init

command = [
    "opencode",
    "--standalone",
]
rw_maps = ["~/.local/share/opencode"]
ro_maps = [
    "~/.agents/skills",
    "~/dotfiles/.config/herdr",
    "~/dotfiles/.config/tuicr",
    "~/.local/bin",
    "~/.local/share/tuicr",
    "~/.config/opencode",
]
network = true
